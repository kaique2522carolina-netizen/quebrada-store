# ─────────────────────────────────────────────────────────
# QUEBRADA STORE — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# ─────────────────────────────────────────────────────────

# ── MERCADO PAGO ──────────────────────────────────────────
# Obtenha em: https://www.mercadopago.com.br/developers
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxx

# ── URLs ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
# Em produção use sua URL real, ex: https://seusite.com.br

# ── WEBHOOK ───────────────────────────────────────────────
# URL que o Mercado Pago vai notificar quando o pagamento mudar
# Use ngrok em dev: ngrok http 3001
WEBHOOK_URL=https://SEU-NGROK.ngrok-free.app/api/payment/webhook

# ── SERVIDOR ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development
